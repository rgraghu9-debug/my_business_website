# ============================================================
# Environment variables for local development
# Copy this file to .env and fill in the real values.
# Do NOT commit .env to source control.
# ============================================================

# Django secret key — generate a new one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
# Example: mysite.onrender.com,www.mysite.com
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string (leave empty to use SQLite locally)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Your WhatsApp number in international format, digits only
# e.g. 919876543210 for +91 98765 43210
WHATSAPP_NUMBER=919999999999
